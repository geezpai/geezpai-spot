config APP_DFU
	bool "Enable MCUmgr OTA DFU over Bluetooth"
	default y
	depends on BOOTLOADER_MCUBOOT || SOC_SERIES_NRF54H

config BT_FAST_PAIR_MODEL_ID
	hex "Fast Pair Model ID"
	default 0x000000

config BT_FAST_PAIR_ANTI_SPOOFING_PRIVATE_KEY
	string "Fast Pair Anti-Spoofing Private Key"
	default ""

source "share/sysbuild/Kconfig"
