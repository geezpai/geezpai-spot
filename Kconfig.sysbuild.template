# ===== REPLACE WITH YOUR REAL MODEL ID =====
# Get from Google Nearby console after registering your device.
config BT_FAST_PAIR_MODEL_ID
	default 0x000000

# ===== REPLACE WITH YOUR REAL ANTI-SPOOFING KEY =====
# Generate with: openssl ecparam -genkey -name prime256v1 -out key.pem
# Then convert to base64.
config BT_FAST_PAIR_ANTI_SPOOFING_PRIVATE_KEY
	default ""

config APP_DFU
	bool "Enable MCUmgr OTA DFU over Bluetooth"
	default y
	depends on BOOTLOADER_MCUBOOT || SOC_SERIES_NRF54H
	help
	  This option enables the DFU functionality in this application.
	  The DFU solution is supported for the MCUboot-based targets
	  (BOOTLOADER_MCUBOOT Kconfig) and for the SUIT-based targets
	  (SOC_SERIES_NRF54H Kconfig).

source "share/sysbuild/Kconfig"
